{
  "name": "sqlrename",
  "displayName": "sqlrename",
  "description": "Rename sql objects based on csv mapping",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sqlrename.helloWorld",
        "title": "sqlrename: Hello World"
      },
      {
        "command": "sqlrename.renameSelection",
        "title": "SQL Rename: Rewrite Selection"
      }
    ],
    "keybindings": [
      {
        "command": "sqlrename.renameSelection",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "SQL Rename",
      "properties": {
        "sqlrename.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python 3 executable. Use 'python3' (macOS/Linux), 'python' (Windows), or an absolute path."
        },
        "sqlrename.mappingCsvPath": {
          "type": "string",
          "default": "name_conversion.csv",
          "description": "Mapping CSV filename (resolved relative to rename_engine/) or absolute path to a custom CSV."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.39.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
